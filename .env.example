# 가공관리 Pro — 로컬 환경변수 (.env 로 복사 후 사용, Git 커밋 금지)
# 집·회사 PC 모두 동일한 Supabase 프로젝트 값을 넣으세요.

VITE_SUPABASE_URL=https://myhujwvcrdzamsxwxeff.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# 개발·테스트 시 로그인 생략 (배포/Vercel에서는 false 또는 삭제)
VITE_SKIP_AUTH=true

# (선택) DB migration CLI 자동 적용 — Supabase → Project Settings → Database → password
# Git/채팅에 공유 금지. 없으면 SQL Editor에서 supabase/migrations/*.sql 수동 실행
# SUPABASE_DB_PASSWORD=your-db-password
